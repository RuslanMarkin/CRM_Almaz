# Use a separate account/bucket from production files. The credentials must only allow PutObject.
BACKUP_DATABASE_URL=mysql://backup_user:strong_password@mysql-host:3306/logistics_docs
BACKUP_S3_URI=s3://company-logistics-backups/mysql

# Standard AWS CLI variables; for Yandex Object Storage also set AWS_ENDPOINT_URL.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=ru-central1
AWS_ENDPOINT_URL=https://storage.yandexcloud.net
