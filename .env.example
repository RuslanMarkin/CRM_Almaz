# Required: persistent MySQL database shared by all visitors
DATABASE_URL=mysql://user:password@host:3306/logistics_docs

# Required for password authentication. Never commit real values.
ADMIN_USERNAME=admin
# scrypt$16384$8$1$<salt-base64url>$<hash-base64url>
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional legacy integrations
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional durable storage for document scans. The default (database) keeps
# current behaviour. Set ATTACHMENTS_STORAGE=s3 to save new scans in a private
# S3-compatible bucket; the database will retain only the object key.
ATTACHMENTS_STORAGE=database
S3_BUCKET=
S3_REGION=ru-central1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
