# Required: persistent MySQL database shared by all visitors
DATABASE_URL=mysql://user:password@host:3306/logistics_docs

# Required for password authentication. Never commit real values.
ADMIN_USERNAME=admin
# scrypt$16384$8$1$<salt-base64url>$<hash-base64url>
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-random-32-character-minimum-secret

# Optional legacy integrations
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Storage for document scans. Set ATTACHMENTS_STORAGE=s3 to store scans in S3/MinIO.
# The default Docker Compose setup provides a local MinIO service:
ATTACHMENTS_STORAGE=s3
S3_BUCKET=almaz-scans
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=almaz_minio_admin
S3_SECRET_ACCESS_KEY=almaz_minio_secret_password
S3_FORCE_PATH_STYLE=true

# DaData API (https://dadata.ru/api/find-bank/) for auto-filling bank details by BIK.
# 10,000 requests/day are free after registration at https://dadata.ru/profile/#info
# If empty, built-in Russian Central Bank catalog fallback is used automatically.
DADATA_API_KEY=
